GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback

# MongoDB. `memory://` runs an in-memory mongomock client (zero setup, local/demo).
# Production (e.g. MongoDB Atlas free cluster):
#   MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
#   MONGODB_DB=reposweep
MONGODB_URI=memory://
MONGODB_DB=reposweep

SECRET_KEY=change-me-to-a-long-random-string

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Directory of the built frontend served by the backend (local production build)
FRONTEND_DIST=../frontend/dist

# Set to true to force demo mode even if OAuth credentials exist
MOCK_MODE=false